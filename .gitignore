# =========================
# RAW DATA (NEVER COMMIT)
# =========================
data/raw/

# Generated data marts.
# These ARE committed: Streamlit Cloud builds from the repo and never runs the
# ETL, so an untracked mart simply does not exist in the deployed app. This rule
# used to ignore them all, which silently kept employer_geo (state analysis) and
# employer_contract (premium) out of production while the older marts stayed
# tracked from before the rule existed. Ignore stray parquet elsewhere instead.
*.parquet
# Both patterns are needed: the first covers data/marts/trend_summary.parquet,
# the second the per-plan-year partitions in data/marts/<year>/. A single
# data/marts/*.parquet does NOT reach into subdirectories, which silently kept
# every year partition out of the deploy.
!data/marts/*.parquet
!data/marts/**/*.parquet

# Generated Excel exports (regenerate with scripts/export_dataset.py)
exports/

# =========================
# STREAMLIT SECRETS
# =========================
.streamlit/secrets.toml

# =========================
# PYTHON
# =========================
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd

